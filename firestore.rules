rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(householdId) {
      return isSignedIn() && (
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.memberUids
      );
    }

    // User profile documents: each authenticated user can read and write their own document
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Household shared workspaces
    match /households/{householdId} {
      // Anyone signed in can query/read their household or find a household by invite code or email
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.memberUids;
      
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids ||
        (resource.data.memberEmails != null && request.auth.token.email in resource.data.memberEmails) ||
        resource.data.inviteCode != null
      );
      
      allow update: if isSignedIn() && (
        request.auth.uid in resource.data.memberUids ||
        (request.auth.uid in request.resource.data.memberUids)
      );
      
      allow delete: if isSignedIn() && resource.data.createdBy == request.auth.uid;

      // Synchronized ledger and all nested collections
      match /{document=**} {
        allow read, write: if isMember(householdId);
      }
    }
  }
}
